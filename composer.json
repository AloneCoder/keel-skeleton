{
    "name": "keel/skeleton",
    "description": "Project template for the Keel micro-framework: composer create-project keel/skeleton my-app",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "keel/framework": "^1.1",
        "symfony/console": "^7.3|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php bin/setup"
        ],
        "test": "phpunit",
        "stan": "phpstan analyse",
        "serve": "@php bin/console keel:serve",
        "serve:worker": "@php bin/console keel:serve --watch",
        "openapi": "@php bin/console keel:openapi --output=public/openapi.json",
        "compile": "@php bin/console keel:compile",
        "preload": "@php bin/console keel:preload"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
